{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/who-is-who", "destination": "/as-biz-dev", "permanent": true },
    { "source": "/whoiswho", "destination": "/as-biz-dev", "permanent": true },
    { "source": "/nos-valeurs", "destination": "/as-biz-dev", "permanent": true },
    { "source": "/nosvaleurs", "destination": "/as-biz-dev", "permanent": true },
    {
      "source": "/notre-savoir-faire",
      "destination": "/as-biz-dev",
      "permanent": true
    },
    {
      "source": "/notresavoirfaire",
      "destination": "/as-biz-dev",
      "permanent": true
    },
    { "source": "/nossolutions", "destination": "/nos-solutions", "permanent": true },
    {
      "source": "/nospartenaire",
      "destination": "/nos-partenaires",
      "permanent": true
    },
    {
      "source": "/nospartenaires",
      "destination": "/nos-partenaires",
      "permanent": true
    },
    { "source": "/category/news", "destination": "/news", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/brand_assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    }
  ]
}
