# ─────────────────────────────────────────────────────────────────────────────
# Contact form. Copy this file to `.env` and fill in ONE of the two setups.
#
# The form sends a plain JSON POST — no backend of our own to deploy or run.
# Payload: { name, prenom, email, message, _gotcha }
# `_gotcha` is the spam honeypot: always empty for real visitors.
#
# Until this is configured, the form falls back to opening the visitor's mail
# client with their message pre-filled, so a lead is never silently dropped.
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A — Web3Forms (no account needed) ─────────────────────────────────
# Enter your email at https://web3forms.com and they send you an access key.
# Submissions are forwarded to that address.
#
#   VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#   VITE_CONTACT_ACCESS_KEY=your-access-key-here

# ── Option B — Formspree (requires a free account) ───────────────────────────
# The form ID in the URL identifies the destination, so no access key.
#
#   VITE_CONTACT_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=

# ⚠️  Vite bakes VITE_* variables into the JS at BUILD time.
#     Change these and you must rebuild — editing .env alone does nothing.

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn article ingestion (api/ingest-article.js, §24 — Articles & Insights).
# Server-side only, not prefixed VITE_ — never exposed to the browser bundle.
# Called by an n8n workflow (server-to-server, credential in n8n's own store)
# for every new LinkedIn post; /internal/add-article.html is a manual fallback
# only. The endpoint commits directly to the default branch — no PR, no
# review step — so this token must never be pasted into a page a browser
# loads other than the fallback form, and that form's URL should be treated
# as a secret too.
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret n8n's HTTP Request node must send as the `x-ingest-token` header.
INGEST_TOKEN=0000

# Fine-grained GitHub PAT scoped to this repo only — Contents (read/write)
# permission is sufficient; no Pull requests permission needed.
GITHUB_TOKEN=0000

# "owner/repo", e.g. "as-biz-dev/asbizdev-v2"
GITHUB_REPO=

# Branch commits are pushed to directly. Defaults to "master" if unset.
GITHUB_DEFAULT_BRANCH=
