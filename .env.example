# ─────────────────────────────────────────────────────────────────────────────
# Contact form endpoint. Copy this file to `.env` and paste your form URL.
#
# The form sends a plain JSON POST — no backend of our own to deploy or run.
# Any service that accepts a JSON POST works:
#
#   Formspree   https://formspree.io/f/YOUR_FORM_ID     ← recommended
#   Web3Forms   https://api.web3forms.com/submit
#
# Payload: { name, prenom, email, message, _gotcha }
# `_gotcha` is the spam honeypot — always empty for real visitors, and
# Formspree discards any submission where it is filled.
#
# Until this is set, the form falls back to opening the visitor's mail client
# with their message pre-filled, so a lead is never silently dropped.
# ─────────────────────────────────────────────────────────────────────────────

VITE_CONTACT_ENDPOINT=
